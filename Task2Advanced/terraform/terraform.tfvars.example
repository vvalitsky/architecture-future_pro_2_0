# terraform.tfvars.example — пример значений переменных.
# Скопируйте в <env>.tfvars (например, dev.tfvars) и подставьте свои значения.
# Реальные *.tfvars НЕ коммитятся (см. .gitignore).
#
# Применение с явным файлом переменных:
#   terraform plan  -var-file=dev.tfvars -out=tfplan
#   terraform apply tfplan

# --- Адресация в Yandex Cloud (не секреты, но специфичны для аккаунта) ---
yc_cloud_id  = "b1gxxxxxxxxxxxxxxxxx"
yc_folder_id = "b1gyyyyyyyyyyyyyyyyy"
yc_zone      = "ru-central1-a"

# Путь к JSON-ключу сервисного аккаунта.
# В CI/CD задаётся автоматически из секрета YC_SA_JSON; локально — путь к файлу.
# yc_service_account_key_file = "sa-key.json"

# --- Параметры окружения ---
env                   = "dev"
subnet_v4_cidr_blocks = ["10.10.0.0/24"]

labels = {
  owner = "platform-team"
  cost  = "future-2-0"
}
