# Файлы, исполняемые/интерпретируемые в Linux/Docker, всегда с LF-переводами строк.
# Это защищает от CRLF при checkout на Windows (иначе ломается shebang в bash,
# а также разбор .tf/.yml внутри контейнеров).
*.sh      text eol=lf
*.tf      text eol=lf
*.tfvars  text eol=lf
*.hcl     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
