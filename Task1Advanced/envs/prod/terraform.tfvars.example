# =====================================================================
# Пример файла переменных для окружения PROD.
# Скопируйте в prod.tfvars и заполните реальными значениями.
# Секрет yc_token НЕ храните в файле — используйте:
#   export TF_VAR_yc_token="$(yc iam create-token)"   (Linux/macOS)
#   $env:TF_VAR_yc_token = (yc iam create-token)       (PowerShell)
# =====================================================================

cloud_id  = "b1gxxxxxxxxxxxxxxxxx"
folder_id = "b1gyyyyyyyyyyyyyyyyy"
zone      = "ru-central1-d"

name          = "future20-prod-vm"
cores         = 8
memory_gb     = 16
core_fraction = 100
preemptible   = false

image_id           = "fd8xxxxxxxxxxxxxxxxx" # актуальный Ubuntu из Marketplace
boot_disk_size_gb  = 100
extra_disk_size_gb = 200

subnet_id           = "e9bxxxxxxxxxxxxxxxxx"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

labels = {
  environment = "prod"
  project     = "future20"
  managed_by  = "terraform"
}
